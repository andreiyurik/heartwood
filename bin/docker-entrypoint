#!/bin/bash -e

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  # DEMO_OWNER: the landing's example tree is built with the database (docs/features/landing.md)
  ./bin/rails db:prepare ${DEMO_OWNER:+demo:rurikids}
fi

exec "${@}"
