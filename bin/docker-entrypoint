#!/bin/bash -e

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare

  # The landing's example tree (docs/features/landing.md). Without it the landing has no example
  # link; that must never keep the server from starting.
  if [ -n "$DEMO_OWNER" ]; then
    ./bin/rails demo:rurikids || echo "demo:rurikids failed; starting without the example tree" >&2
  fi
fi

exec "${@}"
