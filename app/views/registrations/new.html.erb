<% page_title t("registrations.title") %>

<div class="auth-wrap">
  <div class="auth-card">
    <h1><%= t("registrations.title") %></h1>
    <p class="auth-lede"><%= t("registrations.lede") %></p>

    <%= render "shared/errors", record: @user if @user.errors.any? %>

    <%= form_with model: @user, url: registration_path, class: "auth-form" do |form| %>
      <label class="input--actor">
        <%= text_field_tag :tree_name, params[:tree_name], class: "input", maxlength: 240,
              placeholder: t("registrations.tree_name_placeholder") %>
        <%= icon_tag "people" %>
      </label>
      <label class="input--actor">
        <%= form.text_field :name, class: "input", required: true, autofocus: true, autocomplete: "name",
              placeholder: t("registrations.name_placeholder") %>
        <%= icon_tag "person" %>
      </label>
      <label class="input--actor">
        <%= form.email_field :email_address, class: "input", required: true, autocomplete: "username",
              placeholder: t("auth.email_placeholder") %>
        <%= icon_tag "email" %>
      </label>
      <label class="input--actor">
        <%= form.password_field :password, class: "input", required: true, autocomplete: "new-password",
              minlength: 8, maxlength: 72, placeholder: t("registrations.password_placeholder") %>
        <%= icon_tag "password" %>
      </label>
      <p class="auth-hint"><%= t("registrations.password_hint") %></p>
      <%= form.submit t("registrations.submit"), class: "btn btn--reversed" %>
    <% end %>

    <p class="auth-alt">
      <%= t("registrations.have_account") %>
      <%= link_to t("auth.sign_in_submit"), new_session_path %>
    </p>
  </div>
</div>
