<% page_title t("digests.unsubscribe_title"), heading: false %>

<div class="auth-wrap">
  <div class="auth-card">
    <h1><%= t("digests.unsubscribe_title") %></h1>
    <% if @user.weekly_digest? %>
      <p class="auth-lede"><%= t("digests.unsubscribe_lede", email: @user.email_address) %></p>
      <%= button_to t("digests.unsubscribe_submit"), digest_unsubscribe_path(params[:token]), class: "btn btn--primary" %>
    <% else %>
      <p class="auth-lede"><%= t("digests.unsubscribed_lede") %></p>
      <%= link_to t("digests.account"), account_path, class: "btn" %>
    <% end %>
  </div>
</div>
