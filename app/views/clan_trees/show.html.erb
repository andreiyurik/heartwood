<% page_title t("nav.tree") %>
<%= live_updates refresh: "replace" %>

<% if @root %>
  <% canvas_page %>
  <% page_meta t("trees.clan_meta",
       people: t("trees.people", count: @graph[:nodes].count { |node| !node[:ghost] }),
       generations: t("trees.generations", count: @graph[:generations]),
       root: @root.display_name) %>
  <% content_for :header do %>
    <%= render "trees/menu" %>
  <% end %>

  <%= render layout: "trees/canvas", locals: { graph: @graph, mode: @mode, depth: @depth, focus_id: @root.id } do %><% end %>
<% else %>
  <%= render "people/blank_slate" %>
<% end %>
