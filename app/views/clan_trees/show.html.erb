<% page_title t("nav.tree") %>
<%= live_updates refresh: "replace" %>

<% if @root %>
  <% canvas_page %>
  <% people = @graph[:nodes].count { |node| !node[:ghost] } %>
  <% generations = @graph[:nodes].reject { |node| node[:ghost] }.map { |node| node[:generation] }.uniq.size %>
  <% page_meta t(generations > 2 ? "trees.clan_meta" : "shared.tree_meta",
       people: t("trees.people", count: people), generations: t("trees.generations", count: generations),
       root: @root.display_name) %>
  <% content_for :header do %>
    <%= render "trees/menu" %>
  <% end %>

  <%= render layout: "trees/canvas", locals: { graph: @graph, mode: @mode, depth: @depth, focus_id: @root.id } do %><% end %>
<% else %>
  <%= render "people/blank_slate" %>
<% end %>
