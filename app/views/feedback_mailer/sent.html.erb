  <%= t("feedback_mailer.sent.page") %>: <%= @page_url ? link_to(@page_url, @page_url) : t("feedback_mailer.sent.no_page") %><br>
  <%= t("feedback_mailer.sent.locale") %>: <%= @locale %>
</p>
