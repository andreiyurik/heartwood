<%= tag.li id: dom_id(person), class: "person-row" do %>
  <% if person.avatar.attached? %>
    <%= image_tag person.avatar, class: "avatar", alt: "" %>
  <% else %>
    <%= initials_avatar person.display_name %>
  <% end %>
  <div class="person-row__body">
    <p class="person-row__name"><%= link_to person.display_name, person %></p>
    <% if person.life_years.present? %>
      <p class="person-row__meta"><%= person.life_years %></p>
    <% end %>
  </div>
<% end %>
