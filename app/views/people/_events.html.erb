<section class="events" id="events">
  <h2><%= t("events.title") %></h2>
  <% if person.events.any? %>
    <ul class="event-list">
      <%= render partial: "events/event", collection: person.events, locals: { person: person } %>
    </ul>
  <% else %>
    <p class="muted"><%= t("events.none") %></p>
  <% end %>

  <% if can_edit? %>
    <%= preserved_frame_tag "add_event" do %>
      <div class="event-add-actions">
        <%= link_to new_person_event_path(person), class: "btn btn--ghost" do %>
          <%= icon_tag "add" %> <%= t("events.add") %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</section>
