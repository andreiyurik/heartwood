<% if person.avatar.attached? %>
  <div class="memories-gallery">
    <%= image_tag person.avatar, class: "avatar avatar--gallery", alt: person.display_name %>
  </div>
  <p class="muted"><%= t("people.memories_more") %></p>
<% else %>
  <%= render "shared/blank_slate", title: t("people.memories_empty_title"), lede: t("people.memories_empty") %>
<% end %>
