<%= form_with model: person, class: "form" do |f| %>
  <%= render "shared/errors", record: person if person.errors.any? %>

  <div class="field"><%= f.label :given_names %><%= f.text_field :given_names, class: "input" %></div>
  <div class="field"><%= f.label :surname %><%= f.text_field :surname, class: "input" %></div>
  <div class="field">
    <%= f.label :sex %>
    <%= f.select :sex, Person::SEXES.map { |v| [t("people.sex.#{v}"), v] }, {}, class: "input" %>
  </div>

  <details class="more-fields" <%= "open" if person.more_fields_filled? || person.errors.any? %>>
    <summary><%= t("forms.more") %></summary>

    <div class="field"><%= f.label :name_prefix %><%= f.text_field :name_prefix, class: "input" %></div>
    <div class="field"><%= f.label :name_suffix %><%= f.text_field :name_suffix, class: "input" %></div>
    <div class="field"><%= f.label :nickname %><%= f.text_field :nickname, class: "input" %></div>

    <div class="field field--biography">
      <%= f.label :biography, t("people.biography_label") %>
      <span class="field-hint"><%= t("people.biography_hint") %></span>
      <%= f.rich_text_area :biography %>
    </div>
  </details>

  <div class="actions">
    <%= f.submit class: "btn btn--reversed" %>
    <%= link_to t("forms.cancel"), (person.persisted? ? person : people_path), class: "btn btn--plain" %>
  </div>
<% end %>
