<% questions = person.questions.open.latest.includes(:asker, :answers, photo: { image_attachment: :blob }) %>

<% if questions.any? %>
  <section class="profile-section questions" id="questions">
    <h2><%= t("questions.title") %></h2>
    <ul class="people-list">
      <%= render partial: "questions/question", collection: questions, locals: { about: false } %>
    </ul>
    <%= preserved_frame_tag "new_question" if can_edit? %>
  </section>
<% elsif can_edit? %>
  <%= preserved_frame_tag "new_question" %>
<% end %>
