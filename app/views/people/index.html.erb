<% page_title t("people.title") %>
<% page_meta t("trees.people", count: Current.tree.people.count) unless blank_tree? %>
<%= live_updates %>

<% if blank_tree? %>
  <%= render "people/blank_slate" %>
<% else %>
  <% content_for :header do %>
    <% if Current.membership.owner? %>
      <%= link_to tree_memberships_path(anchor: "invite"), class: "btn" do %>
        <%= icon_tag "people" %> <span class="btn__label"><%= t("people.invite") %></span>
      <% end %>
    <% end %>
    <% if can_edit? %>
      <%= link_to new_person_path, class: "btn btn--primary", title: "#{t("people.add")} (n)",
            data: { controller: "hotkey", hotkey_key_value: "n", action: "keydown@window->hotkey#trigger" } do %>
        <%= icon_tag "add" %> <span class="btn__label"><%= t("people.add") %></span>
      <% end %>
    <% end %>
  <% end %>

  <% getting_started = GettingStarted.new(Current.tree) %>
  <% if can_edit? && !Current.membership.getting_started_hidden_at && !getting_started.done? %>
    <%= render "people/getting_started", getting_started: getting_started %>
  <% end %>

  <%= form_with url: people_path, method: :get,
        data: { controller: "autocomplete auto-submit", turbo_action: "advance" },
        class: "search-form" do |f| %>
    <div class="search-bar">
      <div class="search-field">
        <%= icon_tag "search" %>
        <%= f.search_field :q, value: @q,
              placeholder: t("people.search_placeholder"),
              aria: { label: t("people.search_placeholder") },
              autocomplete: "off",
              data: { controller: "hotkey", hotkey_key_value: "/",
                      action: "input->autocomplete#search keydown@window->hotkey#trigger" } %>
        <kbd class="search-field__kbd" aria-hidden="true">/</kbd>
      </div>
      <%= f.select :sex,
            Person::SEXES.map { |s| [t("people.sex.#{s}"), s] },
            { include_blank: t("people.sex_filter_all"), selected: @sex },
            class: "search-filter",
            data: { action: "change->auto-submit#submit" } %>
      <%= f.select :sort,
            Person::SORT_OPTIONS.map { |key| [t("people.sort.#{key}"), key] },
            { selected: @sort },
            class: "search-filter",
            data: { action: "change->auto-submit#submit" } %>
      <% if @q.present? || @sex.present? || @sort != Person::SORT_OPTIONS.first %>
        <%= link_to t("people.search_clear"), people_path, class: "btn btn--ghost search-clear" %>
      <% end %>
    </div>
  <% end %>

  <% if @people.any? %>
    <ul class="people-list">
      <%= turbo_frame_tag "people_page_#{@page}", target: "_top", class: "people-page" do %>
        <%= render @people %>
        <% if @more %>
          <%= turbo_frame_tag "people_page_#{@page + 1}", target: "_top", class: "people-page", loading: :lazy,
                src: people_path(q: @q.presence, sex: @sex.presence, sort: @sort, page: @page + 1) %>
        <% end %>
      <% end %>
    </ul>
  <% else %>
    <p class="empty"><%= t("people.search_empty") %></p>
  <% end %>

  <%= cloud_slot("tree_outgrown", tree: Current.tree) if Current.tree.outgrown? %>
  <%= cloud_slot "thanks", place: "milestone" %>
<% end %>
