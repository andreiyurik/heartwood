<% page_title @person.display_name %>
<% back_link people_path %>
<%= live_updates %>

<% content_for :header do %>
  <%= link_to t("people.tree"), person_tree_path(@person), class: "btn", title: "#{t("people.tree")} (t)",
        data: { controller: "hotkey", hotkey_key_value: "t", action: "keydown@window->hotkey#trigger" } %>
  <% if can_edit? %>
    <%= link_to edit_person_path(@person), class: "btn btn--primary", title: "#{t("people.edit_button")} (e)",
          data: { controller: "hotkey", hotkey_key_value: "e", action: "keydown@window->hotkey#trigger" } do %>
      <%= icon_tag "pencil" %> <%= t("people.edit_button") %>
    <% end %>
  <% end %>
  <details class="action-menu">
    <summary class="btn btn--round" title="<%= t("people.more") %>">
      <%= icon_tag "more" %><span class="for-screen-reader"><%= t("people.more") %></span>
    </summary>
    <menu class="action-sheet action-sheet--end">
      <li><%= link_to person_relationship_path(@person), class: "action-sheet__action" do %><%= icon_tag "people" %> <%= t("relationships.cta") %><% end %></li>
      <% if can_edit? %>
        <li><hr class="action-sheet__divider"></li>
        <li>
          <%= button_to person_path(@person), method: :delete, class: "action-sheet__action action-sheet__action--negative",
                form: { data: { turbo_confirm: t("people.remove_confirm", name: @person.display_name), turbo_frame: "_top" } } do %>
            <%= icon_tag "trash" %> <%= t("people.delete_person") %>
          <% end %>
        </li>
      <% end %>
    </menu>
  </details>
<% end %>

<% page_meta [ @person.nickname, @person.life_years, (t("people.sex.#{@person.sex}") unless @person.sex == "U"), (t("people.living") if @person.living?) ].compact_blank.join(" · ") %>
<% content_for :page_avatar do %>
  <% if can_edit? %>
    <%= form_with model: @person, class: "avatar-form", data: { controller: "auto-submit" } do |form| %>
      <label class="avatar-upload" title="<%= t("people.avatar_hint") %>">
        <%= render "people/avatar", person: @person %>
        <%= icon_tag "camera", class: "avatar-upload__badge" %>
        <%= form.file_field :avatar, accept: Person::AVATAR_CONTENT_TYPES.join(","), class: "for-screen-reader",
              data: { action: "change->auto-submit#submit" } %>
        <span class="for-screen-reader"><%= t("people.avatar_label") %></span>
      </label>
    <% end %>
  <% else %>
    <%= render "people/avatar", person: @person %>
  <% end %>
<% end %>

<article class="person">
  <nav class="profile-nav" aria-label="<%= t("people.sections_label") %>">
    <% sections = %w[events family biography sources memories] %>
    <% sections << "map" if @person.located_events.exists? %>
    <% sections.each do |section| %>
      <a href="#<%= section %>"><%= t("people.sections.#{section}") %></a>
    <% end %>
  </nav>

  <%= render "people/events", person: @person %>

  <%= render "people/family", person: @person %>

  <section class="profile-section" id="biography">
    <h2><%= t("people.sections.biography") %></h2>
    <% if @person.biography.present? %>
      <div class="biography lexxy-content"><%= @person.biography %></div>
    <% elsif can_edit? %>
      <%= render "shared/blank_slate", title: t("people.biography_empty_title"), lede: t("people.biography_hint") do %>
        <%= link_to t("people.biography_write"), edit_person_path(@person, anchor: "person_biography"), class: "btn" %>
      <% end %>
    <% else %>
      <p class="muted"><%= t("people.biography_empty_viewer") %></p>
    <% end %>
  </section>

  <section class="profile-section" id="sources">
    <h2><%= t("people.sections.sources") %></h2>
    <%= render "people/sources", person: @person %>
  </section>

  <section class="profile-section" id="memories">
    <h2><%= t("people.sections.memories") %></h2>
    <%= render "people/memories", person: @person %>
  </section>

  <% if @person.located_events.exists? %>
    <section class="profile-section" id="map">
      <h2><%= t("people.sections.map") %></h2>
      <%= render "people/map", person: @person %>
    </section>
  <% end %>
</article>
