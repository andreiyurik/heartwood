<% page_title @person.display_name %>
<% back_link people_path %>
<%= live_updates %>

<% content_for :header do %>
  <%= link_to t("people.tree"), person_tree_path(@person), class: "btn" %>
  <% if can_edit? %>
    <%= icon_link_to "pencil", t("people.edit_button"), edit_person_path(@person), class: "btn--reversed" %>
  <% end %>
<% end %>

<article class="person">
  <div class="profile-identity">
    <% if can_edit? %>
      <%= form_with model: @person, class: "avatar-form", data: { controller: "auto-submit" } do |form| %>
        <label class="avatar-upload" title="<%= t("people.avatar_hint") %>">
          <%= render "people/avatar", person: @person %>
          <%= icon_tag "camera", class: "avatar-upload__badge" %>
          <%= form.file_field :avatar, accept: Person::AVATAR_CONTENT_TYPES.join(","), class: "for-screen-reader",
                data: { action: "change->auto-submit#submit" } %>
          <span class="for-screen-reader"><%= t("people.avatar_label") %></span>
        </label>
      <% end %>
    <% else %>
      <%= render "people/avatar", person: @person %>
    <% end %>
    <p><%= @person.life_years %></p>
  </div>

  <nav class="profile-tabs" aria-label="<%= t("people.tabs_label") %>">
    <% PeopleController::TABS.each do |tab| %>
      <%= link_to t("people.tabs.#{tab}"), person_path(@person, tab: tab),
            class: "profile-tab #{"profile-tab--active" if @tab == tab}",
            aria: { current: @tab == tab ? "page" : nil } %>
    <% end %>
  </nav>

  <div class="tab-panel" id="tab-<%= @tab %>">
    <%= render "people/tabs/#{@tab}", person: @person %>
  </div>

  <section class="relationship-tool">
    <h2><%= t("relationships.section_title") %></h2>
    <p class="muted relationship-lede"><%= t("relationships.lede", name: @person.display_name) %></p>
    <%= turbo_frame_tag "relationship" do %>
      <%= link_to t("relationships.cta"), person_relationship_path(@person), class: "btn" %>
    <% end %>
  </section>
</article>
