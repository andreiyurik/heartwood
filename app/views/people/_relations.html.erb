<div class="relation-group">
  <h3><%= label %></h3>
  <% if people.any? %>
    <ul>
      <% people.each do |relative| %>
        <%= tag.li class: "relation" do %><%= link_to relative.display_name, relative %><% end %>
      <% end %>
    </ul>
  <% else %>
    <p class="muted"><%= t("family.none") %></p>
  <% end %>
</div>
