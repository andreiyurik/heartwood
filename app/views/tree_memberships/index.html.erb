<% page_title t("tree_memberships.title") %>
<% back_link root_path %>

<% if Current.membership.owner? %>
  <% url = join_url(Current.tree.join_code) %>

  <section class="invite-box">
    <strong id="invite_label"><%= t("tree_memberships.invite_label") %></strong>
    <div class="invite-box__actions">
      <input type="text" class="input" value="<%= url %>" aria-labelledby="invite_label" readonly>

      <button type="button" class="btn btn--circle" hidden
              data-controller="share" data-action="share#share"
              data-share-url-value="<%= url %>" data-share-title-value="<%= Current.tree.name %>">
        <%= icon_tag "share" %>
        <span class="for-screen-reader"><%= t("tree_memberships.share") %></span>
      </button>

      <%= button_to_copy_to_clipboard(url) do %>
        <%= icon_tag "copy-paste" %>
        <span class="for-screen-reader"><%= t("tree_memberships.copy_link") %></span>
      <% end %>

      <%= button_to tree_join_code_path, class: "btn btn--circle",
            data: { turbo_confirm: t("tree_memberships.reset_confirm") } do %>
        <%= icon_tag "refresh" %>
        <span class="for-screen-reader"><%= t("tree_memberships.reset_link") %></span>
      <% end %>
    </div>
  </section>
<% end %>

<ul class="people-list">
  <% @memberships.each do |membership| %>
    <li class="person-row">
      <div class="avatar avatar--thumb avatar--initials" aria-hidden="true">
        <%= membership.user.name.split.map(&:first).first(2).join.upcase %>
      </div>
      <span><%= membership.user.name %></span>
      <hr class="separator" aria-hidden="true">

      <% if membership.owner? %>
        <span class="years"><%= icon_tag "crown" %> <%= t("tree_memberships.roles.owner") %></span>
      <% elsif Current.membership.owner? %>
        <%= form_with model: membership, url: tree_membership_path(membership), method: :patch,
              data: { controller: "auto-submit" } do |form| %>
          <%= form.select :role,
                %w[editor viewer].map { |role| [ t("tree_memberships.roles.#{role}"), role ] }, {},
                class: "input", aria: { label: t("tree_memberships.role_label", name: membership.user.name) },
                data: { action: "change->auto-submit#submit" } %>
        <% end %>
        <%= icon_button_to "minus", t("tree_memberships.remove"), tree_membership_path(membership),
              method: :delete, class: "btn--negative",
              data: { turbo_confirm: t("tree_memberships.remove_confirm", name: membership.user.name) } %>
      <% else %>
        <span class="years"><%= t("tree_memberships.roles.#{membership.role}") %></span>
      <% end %>
    </li>
  <% end %>
</ul>
