<%# locals: node (graph node hash), focus (bool), mode (string), depth (integer) %>
<%# Every person is the same card; clicking one loads the person into the slide-over panel. %>
<% if node[:ghost] %>
  <div class="tree-node tree-node--card tree-node--ghost"
       data-tree-target="node"
       data-tree-node-id="<%= node[:id] %>">
    <%= link_to new_person_relative_path(node[:ghost_for], relation: node[:ghost], return_to: request.fullpath),
          data: { turbo_frame: "person-panel" } do %>
      <span class="node-avatar node-avatar--silhouette" aria-hidden="true"><%= render "people/silhouette", sex: nil %></span>
      <span class="ghost-label"><%= t("trees.ghost.#{node[:ghost]}") %></span>
    <% end %>
  </div>
<% else %>
  <% tone = node[:living] ? "living" : (node[:sex]&.downcase || "u") %>
  <div class="tree-node tree-node--card tree-node--<%= tone %> <%= "tree-node--focus" if focus %>"
       data-tree-target="node"
       data-tree-node-id="<%= node[:id] %>">
    <% if node[:living] %>
      <p class="node-name node-name--living"><%= node[:name] %></p>
    <% else %>
      <%= link_to person_panel_path(node[:id], return_to: request.fullpath), data: { turbo_frame: "person-panel" } do %>
        <% if node[:avatar_url].present? %>
          <%= image_tag node[:avatar_url], class: "node-avatar", alt: node[:name] %>
        <% else %>
          <span class="node-avatar node-avatar--silhouette" aria-hidden="true"><%= render "people/silhouette", sex: node[:sex] %></span>
        <% end %>
        <span class="node-text">
          <% if node[:given].present? && node[:surname].present? %>
            <span class="node-name"><%= node[:given] %></span>
            <span class="node-surname"><%= node[:surname] %></span>
          <% else %>
            <span class="node-name"><%= node[:name] %></span>
          <% end %>
          <% if node[:years].present? %>
            <span class="node-dates"><%= node[:years] %></span>
          <% end %>
        </span>
      <% end %>
    <% end %>
  </div>
<% end %>
