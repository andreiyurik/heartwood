<%# locals: graph (graph hash), mode (string), depth (integer), focus_id (id of the highlighted person),
    link_for (optional: person id → page URL, instead of the slide-over panel); the block adds view controls %>
<div class="tree-page"
     data-controller="tree"
     data-tree-graph-value="<%= graph.to_json %>"
     data-tree-mode-value="<%= mode %>"
     data-tree-depth-value="<%= depth %>"
     data-tree-expand-label-value="<%= t("trees.expand") %>"
     data-tree-collapse-label-value="<%= t("trees.collapse") %>">
  <div class="search-bar tree-actions">
    <div class="tree-search">
      <div class="search-field">
        <%= icon_tag "search" %>
        <input type="search" class="tree-search-input"
               data-tree-target="searchInput"
               data-controller="hotkey" data-hotkey-key-value="/"
               data-action="input->tree#search keydown->tree#searchKeys keydown@window->hotkey#trigger"
               placeholder="<%= t("trees.search_placeholder") %>"
               aria-label="<%= t("trees.search_placeholder") %>"
               autocomplete="off">
        <kbd class="search-field__kbd" aria-hidden="true">/</kbd>
      </div>
      <ul class="tree-search-results" data-tree-target="searchResults" hidden></ul>
    </div>
    <%= yield %>
  </div>

  <div class="tree-canvas"
       tabindex="0"
       role="application"
       aria-label="<%= t("trees.canvas_label") %>"
       data-tree-target="canvas"
       data-action="keydown->tree#keydown">
    <canvas class="tree-minimap tree-minimap--hidden"
            data-tree-target="minimap"
            data-action="pointerdown->tree#minimapJump"
            aria-hidden="true"></canvas>

    <div class="tree-zoom">
      <button type="button" class="btn btn--round" data-action="tree#zoomIn" title="<%= t("trees.zoom_in") %>">
        <%= icon_tag "add" %><span class="for-screen-reader"><%= t("trees.zoom_in") %></span>
      </button>
      <button type="button" class="btn btn--round" data-action="tree#zoomOut" title="<%= t("trees.zoom_out") %>">
        <%= icon_tag "minus" %><span class="for-screen-reader"><%= t("trees.zoom_out") %></span>
      </button>
      <button type="button" class="btn btn--round" data-action="tree#zoomFit" title="<%= t("trees.zoom_fit") %>">
        <%= icon_tag "fit" %><span class="for-screen-reader"><%= t("trees.zoom_fit") %></span>
      </button>
    </div>

    <p class="tree-tip" data-tree-target="tip"><%= t("trees.tip") %></p>

    <%# Slide-over person panel: node links load people#panel into this frame; the
        drawer controller opens on frame load and closes on ✕ / Escape. %>
    <aside class="tree-drawer"
           data-controller="drawer"
           data-action="keydown.esc@window->drawer#close">
      <%= turbo_frame_tag "person-panel", target: "_top", data: { drawer_target: "frame" } %>
    </aside>

    <div class="tree-inner" data-tree-target="inner">
      <svg class="tree-edges" data-tree-target="svg" aria-hidden="true"></svg>
      <div class="tree-nodes-layer">
        <% graph[:nodes].each do |nd| %>
          <%= render "trees/node",
                node:  nd,
                focus: nd[:id] == focus_id,
                mode:  mode,
                depth: depth,
                link_for: local_assigns[:link_for] %>
        <% end %>
      </div>
    </div>
  </div>
</div>
