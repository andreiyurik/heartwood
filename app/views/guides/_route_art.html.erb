<%# locals: art. One small scene per step; --i staggers the parts (docs/architecture/design-system.md "Scenes"). %>
<svg class="route-art" viewBox="0 0 96 96" aria-hidden="true">
  <% case art %>
  <% when "ask" %>
    <path d="M14 14h40a6 6 0 0 1 6 6v20a6 6 0 0 1-6 6H32l-10 9v-9h-8a6 6 0 0 1-6-6V20a6 6 0 0 1 6-6z"/>
    <text x="34" y="37">?</text>
    <g class="route-art__pop" style="--i: 2">
      <path class="route-art__paper route-art__accent" d="M46 48h36a6 6 0 0 1 6 6v18a6 6 0 0 1-6 6h-6v9l-10-9H46a6 6 0 0 1-6-6V54a6 6 0 0 1 6-6z"/>
      <path class="route-art__accent" d="M54 63l7 7 13-14"/>
