      <circle class="route-art__paper route-art__accent" cx="48" cy="30" r="5"/>
    </g>
  <% when "records" %>
    <path d="M48 24c-8-6-20-8-36-6v54c16-2 28 0 36 6 8-6 20-8 36-6V18c-16-2-28 0-36 6z"/>
    <path d="M48 24v54M20 32h18M20 42h18M20 52h18"/>
    <rect class="route-art__mark route-art__appear" style="--i: 2" x="55" y="37" width="24" height="10" rx="2"/>
    <path d="M58 32h18M58 42h18M58 52h18"/>
    <g class="route-art__pop" style="--i: 3">
      <circle class="route-art__accent" cx="67" cy="62" r="10"/>
      <path class="route-art__accent" d="M74 69l10 10"/>
    </g>
  <% when "names" %>
    <rect x="12" y="12" width="72" height="20" rx="10"/>
    <rect class="route-art__mark route-art__appear" style="--i: 2" x="12" y="38" width="72" height="20" rx="10"/>
    <rect x="12" y="38" width="72" height="20" rx="10"/>
    <rect x="12" y="64" width="72" height="20" rx="10"/>
    <path d="M22 22h30M22 48h36M22 74h22"/>
    <path class="route-art__accent route-art__draw" style="--i: 3" pathLength="1" d="M64 48l5 5 9-10"/>
  <% when "request" %>
    <rect x="10" y="22" width="76" height="52" rx="5"/>
    <path d="M10 27l38 27 38-27"/>
    <g class="route-art__pop" style="--i: 2">
      <circle class="route-art__paper route-art__accent" cx="72" cy="68" r="13"/>
      <path class="route-art__accent" d="M66 68l5 5 8-9"/>
    </g>
  <% when "keep" %>
    <path d="M26 62V46h44v16"/>
    <circle cx="26" cy="72" r="10"/>
    <circle cx="70" cy="72" r="10"/>
    <path class="route-art__accent route-art__draw" style="--i: 2" pathLength="1" d="M48 46V32"/>
    <circle class="route-art__mark route-art__accent route-art__pop" style="--i: 3" cx="48" cy="21" r="11"/>
  <% end %>
</svg>
