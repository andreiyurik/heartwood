      <rect class="route-art__paper route-art__accent" x="48" y="46" width="34" height="40" rx="3"/>
      <circle class="route-art__accent" cx="65" cy="61" r="6"/>
      <path class="route-art__accent" d="M54 80c2-9 20-9 22 0"/>
    </g>
  <% when "place" %>
    <path d="M10 28l25-9 26 9 25-9v50l-25 9-26-9-25 9z"/>
    <path d="M35 19v50M61 28v50"/>
