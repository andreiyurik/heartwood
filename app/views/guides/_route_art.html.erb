  <% when "papers" %>
    <path d="M20 12h30l16 16v52a4 4 0 0 1-4 4H20a4 4 0 0 1-4-4V16a4 4 0 0 1 4-4z"/>
    <path d="M50 12v16h16M26 40h28M26 50h20M26 60h14"/>
