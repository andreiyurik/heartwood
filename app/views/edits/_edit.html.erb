<%= tag.li id: dom_id(edit), class: class_names("person-row edit-row", "edit-row--reverted": edit.reverted?) do %>
  <%= initials_avatar edit.user.name %>
  <div class="person-row__body">
    <p class="person-row__name"><%= edit_subject(edit) %></p>
    <p class="person-row__meta">
      <%= edit_description(edit) %> · <%= t("edits.by", name: edit.user.name, time: time_ago_in_words(edit.created_at)) %>
    </p>
    <% if edit.reverted? %>
      <p class="person-row__meta"><%= t("edits.reverted", name: edit.reverted_by.name, time: time_ago_in_words(edit.reverted_at)) %></p>
    <% end %>
  </div>

  <% if can_edit? && edit.revertable? %>
    <%= button_to t(edit.removed? ? "edits.restore" : "edits.undo"), edit_reversion_path(edit), class: "btn" %>
  <% end %>
<% end %>
