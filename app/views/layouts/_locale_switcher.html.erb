<nav class="locale-switcher" aria-label="<%= t("locale.switcher") %>">
  <% I18n.available_locales.each do |locale| %>
    <%= button_to t("locale.#{locale}"), locale_path, method: :patch,
          params: { locale: locale, return_to: (request.path if request.get?) }.compact,
          class: ["locale-switcher__btn", { "locale-switcher__btn--active": I18n.locale == locale }],
          aria: { current: I18n.locale == locale ? "true" : nil } %>
  <% end %>
</nav>
