<!DOCTYPE html>
<%= tag.html lang: I18n.locale, data: { theme: chosen_theme } do %>
  <head>
    <title><%= content_for(:title) || brand_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= brand_name %>">
    <meta name="mobile-web-app-capable" content="yes">

    <%# SPA-like page refreshes: morph the DOM in place and preserve scroll (see docs/architecture/rails8-features.md) %>
    <meta name="turbo-refresh-method" content="<%= content_for(:refresh_method).presence || "morph" %>">
    <meta name="turbo-refresh-scroll" content="preserve">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <% if Maps.tiles? %>
      <meta name="map-tiles" content="<%= Maps.config.tiles_url %>">
      <meta name="map-tiles-attribution" content="<%= Maps.config.tiles_attribution %>">
    <% end %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <% if chosen_theme %>
      <meta name="theme-color" content="<%= chosen_theme == "dark" ? "#0f181d" : "#fcf5e9" %>">
    <% else %>
      <meta name="theme-color" content="#fcf5e9" media="(prefers-color-scheme: light)">
      <meta name="theme-color" content="#0f181d" media="(prefers-color-scheme: dark)">
    <% end %>

    <link rel="icon" href="/icon.png" type="image/png" sizes="any">
    <% if Current.tree %>
      <link rel="icon" href="<%= crest_icon_path(v: Current.tree.updated_at.to_i) %>" type="image/svg+xml">
    <% else %>
      <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <% end %>
    <link rel="apple-touch-icon" href="/icon.png">

    <%= preload_link_tag "golos-text-#{I18n.locale == :ru ? "cyrillic" : "latin"}.woff2", as: "font", type: "font/woff2", crossorigin: "anonymous" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "lexxy", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="<%= yield :body_class %>" data-controller="local-time lightbox">
    <a href="#main" class="skip-navigation btn"><%= t("nav.skip_to_content") %></a>

    <%= render "layouts/header" %>

    <% if Current.tree && !blank_tree? %>
      <nav id="toolbar" class="sections" aria-label="<%= t("nav.sections") %>">
        <%= section_link "people", root_path %>
        <%= section_link "tree", clan_tree_path %>
        <%= section_link "map", map_path if Maps.tiles? %>
      </nav>
    <% end %>

    <%= render "layouts/flash" %>

    <main id="main">
      <% if content_for?(:page) %>
        <header class="page-header">
          <%= yield :page_avatar %>
          <div class="page-header__text">
            <h1><%= yield :page %></h1>
            <% if content_for?(:page_meta) %>
              <p class="page-header__meta"><%= yield :page_meta %></p>
            <% end %>
          </div>
        </header>
      <% end %>
      <%= yield %>
    </main>

    <%= render "layouts/lightbox" %>
  </body>
<% end %>
