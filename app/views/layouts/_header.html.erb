<header id="header">
  <nav class="breadcrumbs" aria-label="<%= t("nav.breadcrumbs") %>">
    <% if Current.tree %>
      <%= yield :back %>
      <%= render "layouts/tree_crumb" %>
    <% else %>
      <%= link_to "🌳 Heartwood", root_path, class: "brand" %>
    <% end %>
  </nav>

  <div class="header-actions">
    <%= yield :header %>
  </div>

  <% if Current.tree %>
    <div class="header-account">
      <%= turbo_stream_from Current.tree, :hints %>
      <%= render "hints/badge", count: Current.tree.duplicate_hints.pending.count %>

      <details class="account-menu">
        <summary class="btn btn--ghost btn--round" title="<%= Current.user.name %>">
          <%= initials_avatar Current.user.name, class: "avatar--small" %>
          <span class="for-screen-reader"><%= t("nav.account") %></span>
        </summary>
        <menu class="action-sheet action-sheet--end">
          <li class="action-sheet__who">
            <strong><%= Current.user.name %></strong>
            <span class="txt-subtle"><%= Current.user.email_address %></span>
          </li>
          <li><hr class="action-sheet__divider"></li>
          <li><%= link_to tree_memberships_path, class: "action-sheet__action" do %><%= icon_tag "people" %> <%= t("nav.members") %><% end %></li>
          <% if Current.membership.owner? %>
            <li><%= link_to settings_path, class: "action-sheet__action" do %><%= icon_tag "settings" %> <%= t("nav.settings") %><% end %></li>
          <% end %>
          <li><%= link_to hints_path, class: "action-sheet__action" do %><%= icon_tag "search" %> <%= t("hints.title") %><% end %></li>
          <% unless blank_tree? %>
            <li><hr class="action-sheet__divider"></li>
            <% if can_edit? %>
              <li><%= link_to new_import_path, class: "action-sheet__action" do %><%= icon_tag "upload" %> <%= t("imports.title") %><% end %></li>
            <% end %>
            <li><%= button_to export_path, class: "action-sheet__action" do %><%= icon_tag "download" %> <%= t("exports.create") %><% end %></li>
          <% end %>
          <li><hr class="action-sheet__divider"></li>
          <li>
            <nav class="locale-switcher" aria-label="<%= t("locale.switcher") %>">
              <% I18n.available_locales.each do |loc| %>
                <%= button_to t("locale.#{loc}"), locale_path, method: :patch, params: { locale: loc },
                      class: "locale-switcher__btn #{"locale-switcher__btn--active" if I18n.locale == loc}",
                      aria: { current: I18n.locale == loc ? "true" : nil } %>
              <% end %>
            </nav>
          </li>
          <li><hr class="action-sheet__divider"></li>
          <li><%= button_to session_path, method: :delete, class: "action-sheet__action" do %><%= icon_tag "logout" %> <%= t("nav.sign_out") %><% end %></li>
        </menu>
      </details>
    </div>
  <% else %>
    <div class="header-account">
      <nav class="locale-switcher" aria-label="<%= t("locale.switcher") %>">
        <% I18n.available_locales.each do |loc| %>
          <%= button_to t("locale.#{loc}"), locale_path, method: :patch, params: { locale: loc },
                class: "locale-switcher__btn #{"locale-switcher__btn--active" if I18n.locale == loc}",
                aria: { current: I18n.locale == loc ? "true" : nil } %>
        <% end %>
      </nav>
    </div>
  <% end %>
</header>
