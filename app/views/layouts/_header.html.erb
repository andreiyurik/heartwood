<header id="header">
  <nav class="breadcrumbs" aria-label="<%= t("nav.breadcrumbs") %>">
    <% if Current.tree %>
      <%= yield :back %>
      <%= render "layouts/tree_crumb" %>
    <% else %>
      <%= link_to root_path, class: "brand" do %><%= render "shared/logo" %> <span><%= brand_name %></span><% end %>
    <% end %>
  </nav>

  <div class="header-actions">
    <%= yield :header %>
  </div>

  <% if Current.tree %>
    <div class="header-account">
      <%= turbo_stream_from Current.tree, :hints %>
      <%= render "hints/badge", count: Current.tree.duplicate_hints.pending.count %>

      <details class="account-menu">
        <summary class="btn btn--ghost btn--round" title="<%= Current.user.name %>">
          <%= initials_avatar Current.user.name, class: "avatar--small" %>
          <span class="for-screen-reader"><%= t("nav.account") %></span>
        </summary>
        <menu class="action-sheet action-sheet--end">
          <li class="action-sheet__who">
            <strong><%= Current.user.name %></strong>
            <span class="txt-subtle"><%= Current.user.email_address %></span>
          </li>
          <li><hr class="action-sheet__divider"></li>
          <li><%= link_to account_path, class: "action-sheet__action" do %><%= icon_tag "person" %> <%= t("accounts.title") %><% end %></li>
          <li><%= link_to tree_memberships_path, class: "action-sheet__action" do %><%= icon_tag "people" %> <%= t("nav.members") %><% end %></li>
          <li><%= link_to questions_path, class: "action-sheet__action" do %><%= icon_tag "help-circle" %> <%= t("questions.title") %><% end %></li>
          <li><%= link_to edits_path, class: "action-sheet__action" do %><%= icon_tag "refresh" %> <%= t("nav.history") %><% end %></li>
          <% if Current.membership.owner? %>
            <li><%= link_to settings_path, class: "action-sheet__action" do %><%= icon_tag "settings" %> <%= t("nav.settings") %><% end %></li>
          <% end %>
          <li><%= link_to hints_path, class: "action-sheet__action" do %><%= icon_tag "search" %> <%= t("hints.title") %><% end %></li>
          <% unless blank_tree? %>
            <li><hr class="action-sheet__divider"></li>
            <% if can_edit? %>
              <li><%= link_to new_import_path, class: "action-sheet__action" do %><%= icon_tag "upload" %> <%= t("imports.title") %><% end %></li>
            <% end %>
            <li><%= button_to archives_path, class: "action-sheet__action" do %><%= icon_tag "download" %> <%= t("archives.create") %><% end %></li>
            <li><%= button_to export_path, class: "action-sheet__action" do %><%= icon_tag "download" %> <%= t("exports.create") %><% end %></li>
          <% end %>
          <li><hr class="action-sheet__divider"></li>
          <% if Rails.configuration.x.operator[:email].present? %>
            <li><%= link_to new_feedback_path, class: "action-sheet__action" do %><%= icon_tag "messages" %> <%= t("feedbacks.menu") %><% end %></li>
          <% end %>
          <li>
            <%= theme_button class: "action-sheet__action" do %>
              <%= icon_tag "moon", class: "only-light" %><span class="only-light"><%= t("theme.dark") %></span>
              <%= icon_tag "sun", class: "only-dark" %><span class="only-dark"><%= t("theme.light") %></span>
            <% end %>
          </li>
          <li>
            <%= render "layouts/locale_switcher" %>
          </li>
          <%= cloud_slot "thanks", place: "menu" %>
          <li><hr class="action-sheet__divider"></li>
          <li><%= button_to session_path, method: :delete, class: "action-sheet__action" do %><%= icon_tag "logout" %> <%= t("nav.sign_out") %><% end %></li>
        </menu>
      </details>
    </div>
  <% else %>
    <div class="header-account">
      <%= theme_button class: "btn btn--ghost btn--round", title: t("theme.toggle"), aria: { label: t("theme.toggle") } do %>
        <%= icon_tag "moon", class: "only-light" %><%= icon_tag "sun", class: "only-dark" %>
      <% end %>
      <%= render "layouts/locale_switcher" %>
    </div>
  <% end %>
</header>
