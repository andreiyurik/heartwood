<header id="header">
  <nav class="breadcrumbs" aria-label="<%= t("nav.breadcrumbs") %>">
    <% if Current.tree %>
      <%= yield :back %>
      <%= render "layouts/tree_crumb" %>
      <% if content_for?(:page) %>
        <span class="breadcrumbs__separator" aria-hidden="true">▸</span>
        <h1><%= yield :page %></h1>
      <% end %>
    <% else %>
      <%= link_to "🌳 Heartwood", root_path, class: "brand" %>
    <% end %>
  </nav>

  <div class="header-actions">
    <%= yield :header %>
  </div>

  <div class="header-account">
    <nav class="locale-switcher" aria-label="<%= t("locale.switcher") %>">
      <% I18n.available_locales.each do |loc| %>
        <%= button_to t("locale.#{loc}"), locale_path, method: :patch, params: { locale: loc },
              class: "locale-switcher__btn #{"locale-switcher__btn--active" if I18n.locale == loc}",
              aria: { current: I18n.locale == loc ? "true" : nil } %>
      <% end %>
    </nav>

    <% if Current.tree %>
      <%= turbo_stream_from Current.tree, :hints %>
      <%= render "hints/badge", count: Current.tree.duplicate_hints.pending.count %>
      <% if Current.membership.owner? %>
        <%= icon_link_to "settings", t("nav.settings"), settings_path, class: "btn--plain" %>
      <% end %>
      <%= icon_link_to "people", t("nav.members"), tree_memberships_path, class: "btn--plain" %>
      <%= icon_button_to "logout", t("nav.sign_out"), session_path, method: :delete, class: "btn--plain" %>
    <% end %>
  </div>
</header>
