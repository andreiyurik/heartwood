<% page_title t("hints.title") %>
<% back_link root_path %>

<% if @hints.any? %>
  <% content_for :header do %>
    <%= button_to t("hints.scan"), hints_scan_path, class: "btn" %>
  <% end %>
<% end %>

<p class="muted hints-lede"><%= t("hints.lede") %></p>

<% if @hints.any? %>
  <ul class="hints-list" id="hints">
    <%= render partial: "hint", collection: @hints %>
  </ul>
<% else %>
  <%= render "shared/blank_slate", id: "hints", title: t("hints.empty"), lede: t("hints.empty_lede") do %>
    <%= button_to t("hints.scan"), hints_scan_path, class: "btn btn--primary" %>
  <% end %>
<% end %>
