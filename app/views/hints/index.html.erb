<% page_title t("hints.title") %>
<% back_link root_path %>

<% content_for :header do %>
  <%= button_to t("hints.scan"), scan_hints_path, method: :post, class: "btn" %>
<% end %>

<p class="muted hints-lede"><%= t("hints.lede") %></p>

<% if @hints.any? %>
  <ul class="hints-list" id="hints">
    <%= render partial: "hint", collection: @hints %>
  </ul>
<% else %>
  <p class="empty" id="hints"><%= t("hints.empty") %></p>
<% end %>
