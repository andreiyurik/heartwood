<span id="hints-badge" class="hints-badge-wrap">
  <% if count.positive? %>
    <%= link_to hints_path, class: "hints-badge", title: t("hints.title") do %>
      <span class="btn__label"><%= t("hints.nav") %></span>
      <span class="hints-badge-count"><%= count %></span>
    <% end %>
  <% end %>
</span>
