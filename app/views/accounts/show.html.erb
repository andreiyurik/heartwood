<% page_title t("accounts.title") %>
<% page_meta "#{Current.user.name} · #{Current.user.email_address}" %>
<% back_link root_path %>

<section class="account-section">
  <h2><%= t("accounts.profile_title") %></h2>
  <%= form_with model: Current.user, url: account_path, method: :patch, class: "form" do |form| %>
    <%= render "shared/errors", record: Current.user if Current.user.errors.any? %>
    <div class="field"><%= form.label :name %><%= form.text_field :name, class: "input", required: true, autocomplete: "name" %></div>
    <div class="field"><%= form.label :email_address %><%= form.email_field :email_address, class: "input", required: true, autocomplete: "username" %></div>
    <div class="field">
      <%= form.label :password, t("accounts.new_password") %>
      <%= form.password_field :password, class: "input", autocomplete: "new-password", minlength: 8, maxlength: 72,
            placeholder: t("accounts.new_password_placeholder") %>
    </div>
    <div class="field">
      <%= form.label :password_challenge, t("accounts.current_password") %>
      <%= form.password_field :password_challenge, class: "input", autocomplete: "current-password", maxlength: 72,
            placeholder: t("accounts.current_password_placeholder") %>
    </div>
    <div class="actions"><%= form.submit t("forms.save"), class: "btn btn--primary" %></div>
  <% end %>
</section>

<section class="account-section" id="letters">
  <h2><%= t("accounts.letters_title") %></h2>
  <%= form_with model: Current.user, url: account_path, method: :patch, class: "account-letters", data: { controller: "auto-submit" } do |form| %>
    <label class="auth-consent">
      <%= form.check_box :weekly_digest, data: { action: "change->auto-submit#submit" } %>
      <span><%= t("accounts.weekly_digest") %></span>
    </label>
    <label class="auth-consent">
      <%= form.check_box :answer_emails, data: { action: "change->auto-submit#submit" } %>
      <span><%= t("accounts.answer_emails") %></span>
    </label>
    <noscript><%= form.submit t("forms.save"), class: "btn" %></noscript>
  <% end %>
</section>

<section class="account-section">
  <h2><%= t("accounts.your_data") %></h2>
  <p class="muted"><%= t("accounts.your_data_lede") %></p>
  <div class="account-section__actions">
    <%= button_to archives_path, class: "btn" do %><%= icon_tag "download" %> <%= t("archives.create") %><% end %>
    <%= button_to export_path, class: "btn" do %><%= icon_tag "download" %> <%= t("exports.create") %><% end %>
    <%= link_to t("legal.privacy.title"), privacy_path, class: "btn btn--ghost" %>
  </div>
</section>

<section class="account-section">
  <h2><%= t("accounts.delete_title") %></h2>
  <p class="muted"><%= t("accounts.delete_lede") %></p>

  <% owned = Current.user.owned_trees.to_a %>
  <% if owned.any? %>
    <ul class="account-trees">
      <% owned.each do |tree| %>
        <li>
          <strong><%= tree.name %></strong>
          <span class="muted"><%= t("accounts.tree_goes", count: tree.users.count - 1) %></span>
        </li>
      <% end %>
    </ul>
  <% end %>

  <%= form_with url: account_path, method: :delete, class: "account-delete",
        data: { turbo_confirm: t("accounts.delete_confirm") } do |form| %>
    <%= form.password_field :password, class: "input", required: true, autocomplete: "current-password",
          placeholder: t("accounts.password_placeholder"), aria: { label: t("accounts.password_placeholder") } %>
    <%= form.submit t("accounts.delete_submit"), class: "btn btn--negative" %>
  <% end %>
</section>
